{
  "Drawer": {
    "component": "Drawer",
    "import": "shroom-backend-sdk/UI/shroomui",
    "version": "1.0.0",
    "propMap": {
      "标题": "title",
      "显示": "show",
      "展开方向": "direction",
      "显示外侧开关": "asideClose",
      "层级": "zindex"
    },
    "valueMap": {
      "direction": {
        "左侧": "left",
        "右侧": "right"
      }
    },
    "numberProps": [
      "zindex"
    ],
    "jsonProps": []
  },
  "Select": {
    "component": "Select",
    "import": "shroom-backend-sdk/UI/shroomui",
    "version": "1.0.0",
    "propMap": {
      "默认值": "defaultValue",
      "选项": "options"
    },
    "valueMap": {},
    "numberProps": [],
    "jsonProps": [
      "options"
    ]
  },
  "AsyncState": {
    "component": "AsyncState",
    "import": "shroom-backend-sdk/UI/shroomui",
    "version": "1.0.0",
    "propMap": {
      "状态": "status",
      "提示文字": "message",
      "操作按钮文字": "actionLabel"
    },
    "valueMap": {
      "status": {
        "加载中": "loading",
        "空数据": "empty",
        "错误": "error"
      }
    },
    "numberProps": [],
    "jsonProps": []
  },
  "MetricValue": {
    "component": "MetricValue",
    "import": "shroom-backend-sdk/UI/shroomui",
    "version": "1.0.0",
    "propMap": {
      "指标名": "label",
      "数值": "value",
      "单位": "unit",
      "小数位": "precision",
      "空值占位": "emptyValue",
